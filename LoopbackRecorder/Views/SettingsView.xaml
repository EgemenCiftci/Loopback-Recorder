<UserControl x:Class="LoopbackRecorder.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:LoopbackRecorder.ViewModels"
             xmlns:enums="clr-namespace:LoopbackRecorder.Enums"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             d:DesignHeight="550" d:DesignWidth="700">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="FormatsValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type enums:Formats}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:Formats"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="Border" x:Key="SettingsCard">
            <Setter Property="Background" Value="#252A28"/>
            <Setter Property="BorderBrush" Value="#3A403D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SettingLabel">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F5F7F6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Configure recording post-processing" Foreground="#AEB7B3" Margin="0,0,0,18"/>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding CanRemoveSilence}" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Remove silence" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Trim silent sections from completed recordings" Foreground="#AEB7B3" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,16,0,0" IsEnabled="{Binding CanRemoveSilence}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Slider Value="{Binding SilenceThreshold}" Minimum="0" Maximum="0.5"
                                LargeChange="0.1" SmallChange="0.01" TickFrequency="0.01"
                                TickPlacement="BottomRight" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SilenceThreshold, StringFormat={}{0:F2}}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Convert audio" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Export recordings in another audio format" Foreground="#AEB7B3" Margin="0,3,0,12"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding CanConvert}" VerticalAlignment="Top" Margin="12,2,0,0"/>
                    <ComboBox Grid.Row="1" Grid.ColumnSpan="2"
                              ItemsSource="{Binding Source={StaticResource FormatsValues}}"
                              SelectedItem="{Binding ConvertFormat}" IsEnabled="{Binding CanConvert}" Height="34"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Transcribe audio" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Automatically generate text with Whisper" Foreground="#AEB7B3" Margin="0,3,0,12"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding CanTranscribe}" VerticalAlignment="Top" Margin="12,2,0,0"/>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                             Text="{Binding TranscribeModelName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanTranscribe}" Height="34"
                             VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
